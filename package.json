{
  "name": "pulso-digest-bot",
  "version": "1.0.0",
  "description": "Telegram bot for aggregating and digesting posts from channels",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "auth": "node src/auth.js",
    "auth:youtube": "node src/auth-youtube.js",
    "cron:collect": "node src/cron-job.js --action=collect",
    "cron:digest": "node src/cron-job.js --action=digest",
    "dev": "nodemon src/index.js",
    "deploy": "./deploy-remote.sh",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "node --test 'test/*.test.js'"
  },
  "dependencies": {
    "better-sqlite3": "^11.6.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "telegraf": "^4.16.3",
    "telegram": "^2.19.50",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.2",
    "globals": "^17.3.0",
    "nodemon": "^3.1.9"
  }
}
