# --- Telegram Bot (required) ---
# From @BotFather: /newbot → paste token here
BOT_TOKEN=

# --- GramJS (for reading channels via MTProto) ---
# Get at https://my.telegram.org/apps (API ID and API Hash)
TG_API_ID=
TG_API_HASH=
# Leave empty; run `node src/auth.js` once, it will save the session here in DB

# --- AI Providers (multi-provider with auto-fallback) ---
# AI_PROVIDER: auto (default), gemini, groq, openrouter
# Default "auto" tries providers in order: Gemini → Groq → OpenRouter
AI_PROVIDER=auto

# --- Gemini (Google) ---
# API key from Google AI Studio; proxy URL = your xray/socks endpoint on VPS
# Free tier: 1000 RPD (Flash-Lite), 250 RPD (Flash), 100 RPD (Pro)
GEMINI_API_KEY=
GEMINI_PROXY_URL=http://127.0.0.1:10808
GEMINI_MODEL=gemini-3.6-flash

# --- Groq (Ultra-fast LPU inference) ---
# Get API key at https://console.groq.com
# Free tier: ~500K tokens/day, no credit card required
# Models: openai/gpt-oss-120b, groq/compound, nvidia/nemotron-3-super-120b-a12b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- OpenRouter (29+ free models) ---
# Get API key at https://openrouter.ai
# Free tier: 200 requests/day, 20 RPM per model
# Models: google/gemma-4-31b-it:free, z-ai/glm-5.2:free, etc.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional: for ranking on openrouter.ai
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# --- Channels (optional) ---
# Comma-separated usernames without @ (e.g. channel1,channel2). Can add via bot later.
CHANNELS=

# --- Admin ---
# Your Telegram user_id (e.g. from @userinfobot). Only this user can use /ban, /close, etc.
ADMIN_ID=

# --- Database ---
DB_PATH=./data/db.sqlite

# --- Debug ---
# Set to "1" or "true" to enable AI debug logging in console
DEBUG_AI=
